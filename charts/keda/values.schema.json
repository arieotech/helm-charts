{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KEDA",
  "description": "Arieotech production KEDA chart values schema",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imagePullSecrets": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "additionalProperties": false
    },
    "operator": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "registry": { "type": "string", "minLength": 1 },
            "repository": { "type": "string", "minLength": 1 },
            "tag": {
              "type": "string",
              "minLength": 1,
              "not": { "pattern": "^latest$" },
              "description": "'latest' is rejected — pin to a version or use digest."
            },
            "digest": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          },
          "required": ["registry", "repository", "tag"]
        },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": { "type": "string" },
                "memory": { "type": "string" }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "memory": { "type": "string" }
              }
            }
          }
        },
        "watchNamespace": {
          "type": "string",
          "description": "Comma-separated list of namespaces to watch. Empty = cluster-wide (Arieotech fix for upstream #5943)."
        },
        "extraEnv": { "type": "array" },
        "logLevel": {
          "type": "string",
          "enum": ["debug", "info", "error"]
        },
        "logEncoder": {
          "type": "string",
          "enum": ["console", "json"]
        },
        "logTimeFormat": {
          "type": "string",
          "enum": ["epoch", "millis", "nano", "iso8601", "rfc3339", "rfc3339nano"]
        }
      }
    },
    "metricsApiServer": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "registry": { "type": "string", "minLength": 1 },
            "repository": { "type": "string", "minLength": 1 },
            "tag": {
              "type": "string",
              "minLength": 1,
              "not": { "pattern": "^latest$" }
            },
            "digest": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          },
          "required": ["registry", "repository", "tag"]
        },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": { "type": "string" },
                "memory": { "type": "string" }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "memory": { "type": "string" }
              }
            }
          }
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "extraEnv": { "type": "array" },
        "logLevel": { "type": "string" }
      }
    },
    "admissionWebhooks": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "properties": {
            "registry": { "type": "string", "minLength": 1 },
            "repository": { "type": "string", "minLength": 1 },
            "tag": {
              "type": "string",
              "minLength": 1,
              "not": { "pattern": "^latest$" }
            },
            "digest": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          },
          "required": ["registry", "repository", "tag"]
        },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object",
              "properties": {
                "cpu": { "type": "string" },
                "memory": { "type": "string" }
              }
            },
            "limits": {
              "type": "object",
              "properties": {
                "memory": { "type": "string" }
              }
            }
          }
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "extraEnv": { "type": "array" }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      },
      "additionalProperties": false,
      "if": {
        "properties": { "create": { "const": false } },
        "required": ["create"]
      },
      "then": {
        "properties": { "name": { "type": "string", "minLength": 1 } },
        "required": ["name"],
        "description": "create: false with no name falls back to the namespace's default ServiceAccount, silently granting it every KEDA ClusterRoleBinding/RoleBinding — require an explicit name instead."
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsNonRoot": { "type": "boolean" },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 1 },
        "fsGroup": { "type": "integer", "minimum": 1 },
        "seccompProfile": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["RuntimeDefault", "Localhost", "Unconfined"]
            }
          }
        }
      }
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "allowPrivilegeEscalation": { "type": "boolean" },
        "readOnlyRootFilesystem": { "type": "boolean" },
        "runAsNonRoot": { "type": "boolean" },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "capabilities": {
          "type": "object",
          "properties": {
            "drop": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "seccompProfile": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["RuntimeDefault", "Localhost", "Unconfined"]
            }
          }
        }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "topologySpreadConstraints": { "type": "array" },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "kubeApiServerCIDR": { "type": "string" },
        "extraIngress": { "type": "array" },
        "extraEgress": { "type": "array" }
      }
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] },
        "maxUnavailable": { "type": ["integer", "string"] }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string" },
            "labels": { "type": "object" },
            "interval": { "type": "string" },
            "scrapeTimeout": { "type": "string" },
            "port": { "type": "string" },
            "path": { "type": "string" }
          }
        },
        "prometheusRule": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "namespace": { "type": "string" },
            "labels": { "type": "object" },
            "additionalRules": { "type": "array" }
          }
        }
      }
    },
    "istio": {
      "type": "object",
      "properties": {
        "ambient": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "excludedPorts": {
              "type": "array",
              "items": { "type": "integer" }
            }
          }
        }
      }
    },
    "soc2": {
      "type": "object",
      "properties": {
        "auditLogging": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "dpdp": {
      "type": "object",
      "properties": {
        "dataResidency": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "region": { "type": "string" }
          },
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "properties": { "region": { "type": "string", "minLength": 1 } },
            "required": ["region"]
          }
        }
      }
    },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "initContainers": { "type": "array" },
    "sidecars": { "type": "array" },
    "secrets": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
        "description": "Used verbatim as the suffix of the rendered Secret's name (<fullname>-<key>) — must be a valid Kubernetes resource name segment (lowercase alphanumeric and hyphens, no leading/trailing hyphen)."
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "annotations": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "data": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "stringData": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    }
  }
}
